<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Version>0.1.4</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\Super Fantasy Kingdom</GameDir>
    <ProfileDir Condition="'$(ProfileDir)' == ''">$(APPDATA)\Thunderstore Mod Manager\DataFolder\SuperFantasyKingdom\profiles\Test - Mods</ProfileDir>
    <ManagedDir>$(GameDir)\Super Fantasy Kingdom_Data\Managed</ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <EmbeddedResource Include="src/Art/ContractFrame.png" LogicalName="WeeklyContracts.Art.ContractFrame.png" />
    <EmbeddedResource Include="src/Art/ContractFocus.png" LogicalName="WeeklyContracts.Art.ContractFocus.png" />
    <EmbeddedResource Include="src/Art/Backdrop*.png" LogicalName="WeeklyContracts.Art.%(Filename)%(Extension)" />
    <Reference Include="0Harmony;BepInEx">
      <HintPath>$(ProfileDir)\BepInEx\core\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp;UnityEngine;UnityEngine.CoreModule;UnityEngine.UI;UnityEngine.UIModule;UnityEngine.TextRenderingModule;UnityEngine.ImageConversionModule;UnityEngine.JSONSerializeModule;Unity.TextMeshPro;Unity.InputSystem;Unity.Localization;Newtonsoft.Json">
      <HintPath>$(ManagedDir)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
